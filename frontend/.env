# Base URL for the Auth service API — the single place to change per environment.
#
# Dev: a same-origin path handled by the Vite proxy (see vite.config.ts).
#      This keeps the auth cookie first-party and avoids cross-site cookie issues.
# Prod: set this to your deployed auth API base URL, e.g.
#      VITE_AUTH_API_URL=https://api.yourdomain.com/api/v1
VITE_AUTH_API_URL=/api/v1

# Dev proxy target — where Vite forwards /api requests. Not used in production.
AUTH_PROXY_TARGET=https://airbnb-auth-service.onrender.com
